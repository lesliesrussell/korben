;;; Bindings for `slug`, generated from `examples/adapter/src/lib.rs`.
;;;
;;; Generated by `korben ffi rust`. Edits are lost on regeneration.
;;; The `raw-` declarations are unsafe: each asserts a contract the
;;; compiler cannot check. The wrappers under them are the part other
;;; Korben code is meant to use.
;;;
;;; Every wrapper returns a `Result` even where the Rust function does
;;; not, because the boundary can fail where the function cannot: the
;;; adapter may have panicked, and a returned string may have been one
;;; C cannot carry.
(module slug)

(ffi/c-library "slug")

; The adapter reports failure here rather than in a return value, so a
; function that legitimately returns zero is not read as having failed.
(ffi/c-fn adapter-last-error "korben_export_last_error" [] -> CStr)

(ffi/c-fn raw-slugify "korben_export_slugify" [input: CStr] -> CStr)

;;; `slugify` in the adapter, through `korben_export_slugify`.
(pub fn slugify [input: String] -> Result String String !ffi !unsafe
  (let ffi-value (unsafe (raw-slugify input)))
  (match (unsafe (adapter-last-error))
    (Some ffi-message) (Err ffi-message)
    (None)
      (match ffi-value
        (Some ffi-text) (Ok ffi-text)
        (None) (Err "the adapter returned no string"))))

(ffi/c-fn raw-word-count "korben_export_word_count" [input: CStr] -> CLong)

;;; `word_count` in the adapter, through `korben_export_word_count`.
(pub fn word-count [input: String] -> Result Int String !ffi !unsafe
  (let ffi-value (unsafe (raw-word-count input)))
  (match (unsafe (adapter-last-error))
    (Some ffi-message) (Err ffi-message)
    (None) (Ok ffi-value)))

(ffi/c-fn raw-truncate "korben_export_truncate" [input: CStr limit: CLong] -> CStr)

;;; `truncate` in the adapter, through `korben_export_truncate`.
(pub fn truncate [input: String limit: Int] -> Result String String !ffi !unsafe
  (let ffi-value (unsafe (raw-truncate input limit)))
  (match (unsafe (adapter-last-error))
    (Some ffi-message) (Err ffi-message)
    (None)
      (match ffi-value
        (Some ffi-text) (Ok ffi-text)
        (None) (Err "the adapter returned no string"))))

(ffi/c-fn raw-ratio "korben_export_ratio" [numerator: CDouble denominator: CDouble] -> CDouble)

;;; `ratio` in the adapter, through `korben_export_ratio`.
(pub fn ratio [numerator: Float64 denominator: Float64] -> Result Float64 String !ffi !unsafe
  (let ffi-value (unsafe (raw-ratio numerator denominator)))
  (match (unsafe (adapter-last-error))
    (Some ffi-message) (Err ffi-message)
    (None) (Ok ffi-value)))
