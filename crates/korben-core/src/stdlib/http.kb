;;; HTTP/1.1, written in Korben over `std.net`.
;;;
;;; Requests and responses are ordinary records, errors are an ordinary enum,
;;; and routing is ordinary pattern matching — the language describes its own
;;; protocol handling rather than hiding it behind a native module.
;;;
;;; Connections are served concurrently, without any task suspending. The server
;;; owns its listener and every open connection, waits for readiness across all
;;; of them at once, and calls the handler only once a whole request has
;;; arrived — so a handler always runs to completion, and a client that connects
;;; and says nothing, or stops halfway through a request, holds up only itself.
;;;
;;; Where the operating system cannot be asked which sockets are ready — anywhere
;;; without `poll` — the server offers each open connection in turn instead. That
;;; costs a few milliseconds of latency, not the concurrency.

(module std.http
  (use std.net :as net)
  (use std.process :as process)
  (use std.string :as string))

(pub type Request
  {method: Keyword
   path: String
   query: Map String String
   headers: Map String String
   body: String})

(pub type Response
  {status: Int
   headers: Map String String
   body: String})

(pub enum HttpError
  (BadRequest message: String)
  (Transport cause: String)
  (Unsupported detail: String))

;; ------------------------------------------------------------- constructing

;;; A plain-text response.
(pub fn text [status: Int body: String] -> Response
  (Response
    {status status
     headers {"content-type" "text/plain; charset=utf-8"}
     body body}))

;;; A JSON response. The body is expected to be encoded already.
(pub fn json [status: Int body: String] -> Response
  (Response
    {status status headers {"content-type" "application/json"} body body}))

;;; The response for a path nothing handled.
(pub fn not-found [] -> Response
  (json 404 "{\"error\":\"not found\"}"))

;;; A request built by hand, for testing a handler without a socket.
;;;
;;; `headers` and `body` are named and default to empty, so the common case
;;; stays `(test-request :get "/health")`. Without them no handler that reads
;;; a body -- every POST, PUT and PATCH a service has -- could be tested
;;; without opening a socket, which is the part of a service most worth
;;; testing.
(pub fn test-request [method: Keyword path: String
                      :headers headers: Map String String = {}
                      :body body: String = ""] -> Request
  (let split (path-and-query path))
  (Request
    {method method
     path (get split 0 "/")
     query (parse-query (get split 1 ""))
     headers headers
     body body}))

;; ----------------------------------------------------------------- parsing

(fn path-and-query [target: String] -> Vec String
  (match (string.split-once target "?")
    (Some parts) parts
    (None) [target ""]))

(fn parse-query [raw: String] -> Map String String
  (if (empty? raw)
    {}
    (reduce (string.split raw "&") {}
      (fn [collected pair]
        (match (string.split-once pair "=")
          (Some parts) (assoc collected (get parts 0 "") (get parts 1 ""))
          (None) (assoc collected pair ""))))))

(fn parse-headers [lines: Vec String] -> Map String String
  (reduce lines {}
    (fn [collected line]
      (match (string.split-once line ":")
        (Some parts)
          (assoc collected
            (string.lower (string.trim (get parts 0 "")))
            (string.trim (get parts 1 "")))
        (None) collected))))

;;; Parse a whole request. The method becomes a keyword so handlers can match
;;; on `:get` rather than on a string.
(pub fn parse-request [raw: String] -> Result Request HttpError
  (match (string.split-once raw "\r\n\r\n")
    (None) (Err (BadRequest "the request has no header terminator"))
    (Some parts)
      (do
        (let lines (string.split (get parts 0 "") "\r\n"))
        (let start (string.split (get lines 0 "") " "))
        (if (< (len start) 2)
          (Err (BadRequest "the request line is malformed"))
          (do
            (let target (path-and-query (get start 1 "/")))
            (Ok
              (Request
                {method (keyword (string.lower (get start 0 "GET")))
                 path (get target 0 "/")
                 query (parse-query (get target 1 ""))
                 headers (parse-headers (rest lines))
                 body (get parts 1 "")})))))))

;; --------------------------------------------------------------- rendering

(fn status-text [status: Int] -> String
  (match status
    200 "OK"
    201 "Created"
    204 "No Content"
    400 "Bad Request"
    404 "Not Found"
    405 "Method Not Allowed"
    413 "Request Too Large"
    500 "Internal Server Error"
    ;; A status the table does not name still should not claim to be `OK`.
    other :when (>= other 500) "Server Error"
    other :when (>= other 400) "Client Error"
    _ "OK"))

(fn header-lines [headers: Map String String] -> String
  (reduce (keys headers) ""
    (fn [rendered name]
      (str rendered name ": " (get headers name "") "\r\n"))))

;;; Render a response as bytes on the wire. `content-length` is always sent, so
;;; a client knows where the body ends.
(pub fn render-response [response: Response] -> String
  (str
    "HTTP/1.1 " response.status " " (status-text response.status) "\r\n"
    (header-lines response.headers)
    "content-length: " (string.byte-length response.body) "\r\n"
    "connection: close\r\n"
    "\r\n"
    response.body))

;; As above, but saying whether the connection is being kept. Rendering takes
;; the decision as an argument rather than having it written into the headers,
;; so answering a request does not rebuild the response to carry one field.
(fn render-framed [response: Response keep?: Bool] -> String
  (str
    "HTTP/1.1 " response.status " " (status-text response.status) "\r\n"
    (header-lines response.headers)
    "content-length: " (string.byte-length response.body) "\r\n"
    (if keep? "connection: keep-alive\r\n" "connection: close\r\n")
    "\r\n"
    response.body))

;; ------------------------------------------------------------------ reading

(fn content-length [headers: Map String String] -> Int
  (match (string.parse-int (get headers "content-length" "0"))
    (Ok value) value
    (Err _) 0))

;; ------------------------------------------------------------------- server

;;; The most a half-sent request may buffer before the server gives up on it.
;;; A connection that keeps sending without ever completing a request is the
;;; cheapest way to make a server hold memory on someone else's behalf.
(def max-pending: Int 65536)

;;; How long a connection may do nothing at all before it is closed. A client
;;; that connects and never speaks costs a file descriptor and an entry in the
;;; pool; this is what stops it costing them indefinitely.
(def idle-millis: Int 30000)

;; HTTP/1.1 keeps a connection open unless told otherwise, so anything but an
;; explicit `close` is a request to reuse it.
(fn wants-close? [request: Request] -> Bool
  (= (string.lower (get request.headers "connection" "")) "close"))

;; How the buffer stands: -1 when the request is not yet whole, 0 when it holds
;; exactly one, 1 when more bytes followed it.
;;
;; Parsing a head is not free and this is the only place it need happen before
;; the handler runs, so completeness and framing are decided together rather
;; than by two passes over the same bytes.
;;
;; A client that pipelines sends the next request before reading this one's
;; response, so both arrive together. Splitting them apart needs a substring
;; operation, which `std.string` does not have, so that connection is answered
;; once and then closed rather than losing what came after. Ordinary clients
;; do not pipeline.
(fn framing [raw: String] -> Int
  (match (string.split-once raw "\r\n\r\n")
    (None) -1
    (Some parts)
      (do
        (let headers (parse-headers (rest (string.split (get parts 0 "") "\r\n"))))
        (let arrived (string.byte-length (get parts 1 "")))
        (let promised (content-length headers))
        (if (< arrived promised) -1 (if (= arrived promised) 0 1)))))

;; Answer one request. Reports whether the connection is still open.
(fn answer [server: Borrow Pool
            handler: (-> [Request] Response)
            id: Int
            raw: String
            reusable?: Bool] -> Bool !io
  (let parsed (parse-request raw))
  (let keep?
    (match parsed
      (Ok request) (and reusable? (not (wants-close? request)))
      ;; A request that did not parse leaves the stream at an unknown offset,
      ;; so there is nothing safe to read next.
      (Err _) false))
  (let response
    (match parsed
      (Ok request) (handler request)
      (Err error) (json 400 (str "{\"error\":\"" (describe error) "\"}"))))
  (match (server.write id (render-framed response keep?))
    (Ok _) nil
    (Err _) nil)
  (if keep?
    true
    (do (server.close-connection id) false)))

;; Take whatever has arrived on one connection, and answer it if that completed
;; a request. Anything still partial is kept until that connection is ready
;; again, so a client that stops halfway holds up only itself.
(fn advance [server: Borrow Pool
             handler: (-> [Request] Response)
             pending: Map Int String
             id: Int] -> Map Int String !io
  (match (server.read id)
    (Err _) (do (server.close-connection id) (dissoc pending id))
    (Ok outcome)
      (match outcome
        (None) (do (server.close-connection id) (dissoc pending id))
        (Some chunk)
          (do
            (let raw (str (get pending id "") chunk))
            (let state (framing raw))
            (if (>= state 0)
              (do
                (answer server handler id raw (= state 0))
                ;; The buffer is drained either way. A connection kept open
                ;; holds no entry until it sends something, because `pending`
                ;; reads a missing entry as empty -- and keeping one per open
                ;; connection makes every lookup in this table scan them all.
                (dissoc pending id))
              ;; Still partial. Keep it only while it is worth keeping.
              (if (> (string.byte-length raw) max-pending)
                (do
                  (match (server.write id (render-response
                                            (text 413 "request too large")))
                    (Ok _) nil
                    (Err _) nil)
                  (server.close-connection id)
                  (dissoc pending id))
                (assoc pending id raw)))))))

;;; Serve requests until the listener fails.
;;;
;;; `address` is a host and port, such as `"127.0.0.1:3000"`. The server owns
;;; its listener and every open connection, waits for readiness across all of
;;; them at once, and calls the handler only once a whole request has arrived —
;;; so a handler always runs to completion, and a client that connects and says
;;; nothing holds up nobody.
(pub fn serve [address: String handler: (-> [Request] Response)] -> Result Unit HttpError !io
  (match (net.pool address)
    (Err error) (Err (Transport (str error)))
    (Ok opened)
      (with server opened
        (loop [pending {}]
          ;; Stop accepting once a shutdown signal has arrived. A request
          ;; already being answered has finished by the time control returns
          ;; here, because `advance` answers inline -- so nothing is left
          ;; half-served, and the scope closes the listener and every open
          ;; connection on the way out.
          (if (process.shutdown-requested?)
            (Ok nil)
            (match (server.wait 1000)
              (Err error) (Err (Transport (str error)))
              (Ok ready)
                (do
                  (let served (reduce ready pending (fn [waiting id] (advance server handler waiting id))))
                  ;; A connection that has gone quiet is closed here. One that
                  ;; never spoke at all is invisible above -- it is never ready,
                  ;; so nothing up there could decide to give up on it.
                  (match (server.evict idle-millis)
                    (Err _) (recur served)
                    (Ok dropped)
                      (recur (reduce dropped served (fn [waiting id] (dissoc waiting id))))))))))))

;; ------------------------------------------------------------------- client

(fn split-url [url: String] -> Result (Vec String) HttpError
  (match (string.split-once url "://")
    (None) (Err (Unsupported (str "no scheme in " url)))
    (Some scheme-and-rest)
      (if (not= (get scheme-and-rest 0 "") "http")
        (Err (Unsupported "only http:// is supported"))
        (match (string.split-once (get scheme-and-rest 1 "") "/")
          (None) (Ok [(get scheme-and-rest 1 "") "/"])
          (Some parts) (Ok [(get parts 0 "") (str "/" (get parts 1 ""))])))))

(fn with-port [authority: String] -> String
  (if (contains? authority ":") authority (str authority ":80")))

(fn read-all [connection: Borrow Connection collected: String] -> String !io
  (match (connection.read)
    (Err _) collected
    (Ok chunk) (if (empty? chunk) collected (recur connection (str collected chunk)))))

(fn parse-response [raw: String] -> Result Response HttpError
  (match (string.split-once raw "\r\n\r\n")
    (None) (Err (BadRequest "the response has no header terminator"))
    (Some parts)
      (do
        (let lines (string.split (get parts 0 "") "\r\n"))
        (let start (string.split (get lines 0 "") " "))
        (match (string.parse-int (get start 1 "0"))
          (Err _) (Err (BadRequest "the status line is malformed"))
          (Ok status)
            (Ok
              (Response
                {status status
                 headers (parse-headers (rest lines))
                 body (get parts 1 "")}))))))

;;; Fetch a URL. Only `http://` is supported; TLS needs `std.crypto`.
(pub fn get-url [url: String] -> Result Response HttpError !io
  (match (split-url url)
    (Err error) (Err error)
    (Ok parts)
      (do
        (let authority (get parts 0 ""))
        (let target (get parts 1 "/"))
        (match (net.connect (with-port authority))
          (Err error) (Err (Transport (str error)))
          (Ok connection)
            (with open connection
              (let request
                (str "GET " target " HTTP/1.1\r\nhost: " authority
                     "\r\nconnection: close\r\n\r\n"))
              (match (open.write request)
                (Err error) (Err (Transport (str error)))
                (Ok _) (parse-response (read-all open ""))))))))

;;; A readable description of a failure.
(pub fn describe [error: HttpError] -> String
  (match error
    (BadRequest message) message
    (Transport cause) cause
    (Unsupported detail) detail))
