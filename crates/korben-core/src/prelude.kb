;;; The Korben prelude.
;;;
;;; Control-flow macros that expand into the compiler's special forms. They are
;;; written in Korben so that `korben expand` shows exactly what user code
;;; becomes, and so the macro system is exercised by the language itself.

;;; Evaluate the body when `condition` is truthy.
(pub macro when [condition ...body]
  `(if ~condition (do ~@body) nil))

;;; Evaluate the body when `condition` is falsey.
(pub macro unless [condition ...body]
  `(if (not ~condition) (do ~@body) nil))

;;; Short-circuiting conjunction. Returns the last value when every form passes.
(pub macro and [...forms]
  (if (empty? forms)
    true
    (if (= (len forms) 1)
      (get forms 0)
      `(do
         (let value ~(get forms 0))
         (if value (and ~@(rest forms)) false)))))

;;; Short-circuiting disjunction. Returns the first truthy value.
(pub macro or [...forms]
  (if (empty? forms)
    false
    (if (= (len forms) 1)
      (get forms 0)
      `(do
         (let value ~(get forms 0))
         (if value value (or ~@(rest forms)))))))

;;; Test/result pairs, evaluated in order. Use `:else` for the final branch.
(pub macro cond [...clauses]
  (if (empty? clauses)
    nil
    `(if ~(get clauses 0)
       ~(get clauses 1)
       (cond ~@(rest (rest clauses))))))

;;; Bind the payload of a `Some` and take one branch or the other.
(pub macro if-let [binding value then else]
  `(match ~value
     (Some ~binding) ~then
     _ ~else))

;;; Bind the payload of a `Some` and run the body, or return nil.
(pub macro when-let [binding value ...body]
  `(match ~value
     (Some ~binding) (do ~@body)
     _ nil))

;;; Discard the enclosed forms without evaluating them.
(pub macro comment [...forms]
  nil)
